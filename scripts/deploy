deploy()
{
    case $1 in
        build)
            build
        ;;
        help)
            help
        ;;
        run|"")
            build
            ./build/app
        ;;
        *)
            echo "Invalid command!!"
            help
        ;;
    esac
}

build()
{
    if [[ ! -e build ]]; then
        mkdir build
    fi

    g++ src/app.cc -o build/app
}

help()
{
    echo \
    "
        deploy is a project-wide script for running,
        and building programs written in C++.

        build
            Builds an App.exe inside ./build

        run *
            This is the default command.
            Runs src/App.cc
    "
}

deploy $@